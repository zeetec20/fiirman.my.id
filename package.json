{
  "name": "fiirman.my.id",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "sync:medium": "bun run scripts/sync-medium.ts",
    "sync:github": "bun run scripts/sync-github.ts",
    "generate:og-covers": "bun run scripts/generate-og-covers.ts",
    "generate:og-images": "bun run scripts/generate-og-images.tsx",
    "prebuild": "bun run sync:medium && bun run sync:github",
    "build": "bun run sync:medium && bun run sync:github && bun run generate:og-covers && bun run generate:og-images && vite build",
    "preview": "vite preview",
    "prepare": "lefthook install",
    "lint": "biome lint",
    "check": "biome check --write",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@paper-design/shaders-react": "^0.0.81",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cf-wasm/og": "^0.5.0",
    "@cloudflare/workers-types": "^4.20250115.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "fast-xml-parser": "^5.11.1",
    "lefthook": "^2.2.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  }
}
